{
  "version": 1,
  "engine": {
    "type": "adb_pg"
  },
  "source": {
    "type": "csv",
    "log_format": "adb_legacy_33",
    "csv": {
      "path": "../data/input/query_log.csv"
    },
    "mysql": {
      "host": "127.0.0.1",
      "port": 3306,
      "user": "log_reader",
      "password": null,
      "database": "sql_logs",
      "table": ["query_log_day1", "query_log_day2"],
      "batch_rows": 5000
    }
  },
  "partition": {
    "format": "config_json",
    "path": "partition_config.json"
  },
  "output": {
    "directory": "../outputs/runs"
  }
}
